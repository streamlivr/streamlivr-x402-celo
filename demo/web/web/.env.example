# ---------------------------------------------------------------------------
# Demo web app. Copy to .env.local and fill in. Nothing here is a secret in the
# usual sense: every NEXT_PUBLIC_ value is compiled into the browser bundle.
# ---------------------------------------------------------------------------

# The API this demo drives. Prod by default; point at http://127.0.0.1:3000
# when you are running the reference seller in ../server.ts.
NEXT_PUBLIC_API_BASE_URL=https://api.streamlivr.com

# The shared burner the chat signs with. Because it ships in the bundle, treat
# it as public: fund it with a few dollars of testnet USDC and nothing else.
# Generate one, then fund it:
#   node -e "console.log(require('viem/accounts').generatePrivateKey())"
NEXT_PUBLIC_BURNER_PRIVATE_KEY=
NEXT_PUBLIC_BURNER_LABEL=demo burner

# Hard spending limits, in atomic units (USDC has 6 decimals: 10000 = $0.01).
# The per-request cap is enforced before anything is signed; the session cap
# stops a loop from draining the burner.
NEXT_PUBLIC_MAX_ATOMIC_PER_REQUEST=10000
NEXT_PUBLIC_MAX_ATOMIC_PER_SESSION=200000

# Mainnet stays off until explicitly enabled here. Turn it on only once the
# burner holds mainnet funds you are willing to lose.
NEXT_PUBLIC_ENABLE_MAINNET=false
