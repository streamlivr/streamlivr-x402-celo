# ---------------------------------------------------------------------------
# Streamlivr x402 on Celo - example configuration. Copy to .env and fill in.
# Nothing here is a real secret: every value below is a placeholder.
# ---------------------------------------------------------------------------

# Seller
X402_ENABLED=true
# testnet first; switch to mainnet only after the Sepolia canary passes
X402_NETWORK=testnet
# Created by a human at https://x402.celo.org (connect wallet -> create key).
X402_API_KEY=x402_replace_me
# Your own Celo wallet. USDC settles buyer -> this address; the facilitator
# never custodies funds. Must be the wallet you register with the hackathon.
X402_PAY_TO=0x0000000000000000000000000000000000000000

# Settlement asset. USDC works on testnet and mainnet; USDT and USAT are
# mainnet-only and both settle through EIP-3009.
#   USDC | USDT | USAT
X402_SETTLEMENT_ASSET=USDC
X402_ASSET_DECIMALS=6
X402_PING_PRICE_ATOMIC=10000

# ERC-8021 attribution. X402_ATTRIBUTION_TAG is the celo_... code issued when
# you register; it is appended to every transaction this server signs itself
# (payouts, agent registration). x402 settlements are broadcast by the
# facilitator relayer and cannot carry it - those are attributed by the agent
# wallet you register instead. There is no backfill: set this before you send.
X402_ATTRIBUTION_TAG=
# Optional: codes you already use. The issued tag is always encoded last.
X402_ATTRIBUTION_CODES=

# Payout eligibility in production reads the creator's provider-backed KYC
# status, written by that provider's webhook and reconcile worker. This switch
# marks a creator verified without that check, so it exists for local
# development only and is refused when NODE_ENV or the provider environment is
# production. The demo server never reads it.
# X402_LOCAL_KYC_OVERRIDE=false

# Celo fee abstraction: pay gas for treasury transactions in the settlement
# asset instead of CELO. "auto" resolves the documented adapter for the asset.
# Omit to pay gas in CELO.
X402_FEE_CURRENCY=auto

# Buyer canary only (server-side, low-balance throwaway key). Never ship this
# to a browser or mobile bundle.
X402_BUYER_BASE_URL=http://localhost:3000
# Paid route the canary buys. Point it at /api/v1/agent/catalog or
# /api/v1/agent/creator/<id> to exercise creator attribution end to end.
X402_BUYER_PATH=/api/v1/agent/ping
X402_BUYER_PRIVATE_KEY=
X402_BUYER_RPC_URL=https://forno.celo-sepolia.celo-testnet.org
X402_BUYER_MAX_ATOMIC=10000

# ERC-8004 agent registration (npm run x402:register-agent)
AGENT_NAME=Streamlivr
AGENT_DESCRIPTION=Streamlivr pays creators over x402 on Celo. Agents can discover opted-in creator listings, catalogs, and profiles, and every settled payment is attributed back to the creators who supplied the data.
AGENT_SERVICE_URL=https://streamlivr.example
AGENT_A2A_URL=
AGENT_MCP_URL=
CELO_AGENT_REGISTRATION_PRIVATE_KEY=
CELO_RPC_URL=https://forno.celo-sepolia.celo-testnet.org

# Demo
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info
# Optional: require x-demo-token on GET /demo/settlements
DEMO_ADMIN_TOKEN=
